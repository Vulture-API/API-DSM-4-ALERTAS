# Copie para .env e preencha a DATABASE_URL.
# Toda variável nova também deve ser declarada em /src/config/environment.ts.
#
# O .env não vai para o Git. As URLs do Neon estão em "Banco de dados" no
# Confluence do projeto.

NODE_ENV="development"
PORT=3002
DATABASE_URL="postgresql://USUARIO:SENHA@HOST.neon.tech/neondb?sslmode=require"

# Motor de processamento de regras.
#
# Deixe "false" no dia a dia: o banco de development é compartilhado, e vários
# membros rodando o motor ao mesmo tempo disputam o mesmo checkpoint.
# Ligue só quando for testar o motor, e avise o time.
RULES_ENGINE_ENABLED="false"
RULES_ENGINE_INTERVAL_MS=15000
RULES_ENGINE_BATCH_SIZE=500
