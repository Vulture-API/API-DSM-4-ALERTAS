    {
      "name": "05 - Motor de regras",
      "description": "Cada requisição aqui pede um SQL antes, rodado no SQL Editor do Neon.\nSem isso não há leitura nova para o motor avaliar.",
      "item": [
        {
          "name": "Ciclo sem leituras novas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const corpo = pm.response.json();",
                  "",
                  "// Se outro dev inseriu leitura entre o SQL e esta chamada, o número",
                  "// pode não ser 0 — por isso a tolerância.",
                  "pm.test('poucas ou nenhuma leitura pendente', () => {",
                  "  pm.expect(corpo.readings_processed).to.be.at.most(5);",
                  "});",
                  "pm.test('last_reading_id é número, não string', () => {",
                  "  pm.expect(corpo.last_reading_id).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/internal/rules-engine/run",
              "host": ["{{baseUrl}}"],
              "path": ["internal", "rules-engine", "run"]
            },
            "description": "Rode ANTES, no SQL Editor:\n\nUPDATE processing_checkpoints\nSET value = (SELECT COALESCE(MAX(id), 0)::text FROM readings)\nWHERE key = 'rules_engine_last_reading_id';\n\nIsso põe o checkpoint no fim da base, para o motor avaliar só as leituras que você inserir a seguir — e não reprocessar dados de outra pessoa."
          }
        },
        {
          "name": "Leitura abaixo do limite não dispara",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const corpo = pm.response.json();",
                  "pm.test('a leitura foi processada', () => pm.expect(corpo.readings_processed).to.be.at.least(1));",
                  "",
                  "// Contagem exata seria frágil: o banco é compartilhado e outro dev pode",
                  "// ter regra ativa no mesmo sensor. O que importa é a NOSSA regra (>35)",
                  "// não disparar com valor 20.",
                  "pm.test('a regra desta execução não disparou', (feito) => {",
                  "  const configId = Number(pm.collectionVariables.get('configId') || pm.environment.get('configId'));",
                  "  // URL via replaceIn: resolve {{baseUrl}} de qualquer escopo (environment,",
                  "  // coleção ou global). pm.environment.get devolvia undefined em alguns casos",
                  "  // e o erro estourava fora do pm.test, abortando o run antes da limpeza.",
                  "  pm.sendRequest(pm.variables.replaceIn('{{baseUrl}}') + '/api/alerts/triggered?limit=100', (erro, resposta) => {",
                  "    try {",
                  "      pm.expect(erro).to.be.null;",
                  "      const meus = resposta.json().data.filter((a) => a.alert_config_id === configId);",
                  "      pm.expect(meus.length, 'alertas da regra desta execução').to.eql(0);",
                  "      feito();",
                  "    } catch (e) {",
                  "      feito(e);",
                  "    }",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/internal/rules-engine/run",
              "host": ["{{baseUrl}}"],
              "path": ["internal", "rules-engine", "run"]
            },
            "description": "Rode ANTES, no SQL Editor (troque 1 pelo seu sensor_id):\n\nINSERT INTO readings (sensor_id, value, unix_time)\nVALUES (1, 20.0, extract(epoch from now())::bigint);"
          }
        },
        {
          "name": "Leitura acima do limite dispara",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "// A contagem do ciclo não serve como prova: se o motor estiver agendado",
                  "// (RULES_ENGINE_ENABLED=true), o ciclo automático já terá consumido a",
                  "// leitura e esta chamada devolve zero. O que vale é o alerta ter sido",
                  "// criado — conferido direto na listagem.",
                  "pm.test('o alerta da regra desta execução foi criado', (feito) => {",
                  "  const configId = Number(pm.collectionVariables.get('configId') || pm.environment.get('configId'));",
                  "  // URL via replaceIn: resolve {{baseUrl}} de qualquer escopo (environment,",
                  "  // coleção ou global). pm.environment.get devolvia undefined em alguns casos",
                  "  // e o erro estourava fora do pm.test, abortando o run antes da limpeza.",
                  "  pm.sendRequest(pm.variables.replaceIn('{{baseUrl}}') + '/api/alerts/triggered?limit=100', (erro, resposta) => {",
                  "    try {",
                  "      pm.expect(erro).to.be.null;",
                  "      const meus = resposta.json().data.filter((a) => a.alert_config_id === configId);",
                  "      pm.expect(meus.length, 'alertas da regra desta execução').to.be.at.least(1);",
                  "      feito();",
                  "    } catch (e) {",
                  "      feito(e);",
                  "    }",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/internal/rules-engine/run",
              "host": ["{{baseUrl}}"],
              "path": ["internal", "rules-engine", "run"]
            },
            "description": "Rode ANTES, no SQL Editor (troque 1 pelo seu sensor_id):\n\nINSERT INTO readings (sensor_id, value, unix_time)\nVALUES (1, 38.5, extract(epoch from now())::bigint);"
          }
        },
        {
          "name": "Listar alertas pendentes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const configId = Number(pm.collectionVariables.get('configId') || pm.environment.get('configId'));",
                  "const meu = pm.response.json().data.find((a) => a.alert_config_id === configId);",
                  "",
                  "pm.test('o alerta desta execução aparece', () => pm.expect(meu).to.not.be.undefined);",
                  "",
                  "if (meu) {",
                  "  pm.collectionVariables.set('alertaId', meu.id);",
                  "  pm.test('id é número, não string', () => pm.expect(meu.id).to.be.a('number'));",
                  "  pm.test('reading_id é número, não string', () => pm.expect(meu.reading_id).to.be.a('number'));",
                  "  pm.test('ainda não reconhecido', () => pm.expect(meu.acknowledged_at).to.be.null);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/alerts/triggered?acknowledged=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "alerts", "triggered"],
              "query": [
                {
